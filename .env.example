# ─── NOVA configuration ──────────────────────────────────────────────────────
# Copy to .env and adjust. Everything has a safe default for local development.

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# SQLite file. Use :memory: for throwaway runs.
# On Vercel/Lambda this defaults to /tmp/nova.db automatically (read-only mount).
DATABASE_PATH=./data/nova.db

# REQUIRED in production — signs HS256 session tokens.
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_TTL_SECONDS=43200

# Comma separated origins, or * to reflect any origin (dev default).
CORS_ORIGINS=*

# Rate limiting
RATE_MAX=240
ASSISTANT_RATE_MAX=40

# ─── AI engine ───────────────────────────────────────────────────────────────
# NOVA ships with a built-in grounded retrieval engine (zero external calls).
# To upgrade the assistant to a hosted OpenAI-compatible model, set the three
# variables below — retrieval, tools and safety context are injected for you.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_TEMPERATURE=0.4
# AI_MAX_TOKENS=700
# AI_TIMEOUT_MS=30000

# Seed a small welcome balance for new accounts (great for demos).
DEMO_MODE=true
FEATURE_AUTOTOPUP=true

# ─── Web (build-time, optional) ──────────────────────────────────────────────
# Leave empty: the SPA calls same-origin /api, which works with the Vite dev
# proxy, the Vercel `/api/(.*)` rewrite, and the single-image Docker deploy.
# VITE_API_BASE=https://api.example.com
