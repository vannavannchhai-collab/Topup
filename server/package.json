{
  "name": "@nova/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --watch --no-warnings=ExperimentalWarning --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning dist/index.js",
    "seed": "node --experimental-sqlite --no-warnings=ExperimentalWarning --import tsx src/db/seed.ts",
    "test": "node --experimental-sqlite --no-warnings=ExperimentalWarning --import tsx --test src/tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
